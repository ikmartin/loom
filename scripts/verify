#!/usr/bin/env python3
"""Run the workspace's verification: one command, one table, CI's state last (docs/contributing.md).

Usage:
    scripts/verify [fast|full|paper|client] [--only loom|arras|docs] [--workers N]
    scripts/verify --steps NAME[,NAME...] [--only loom|arras|docs] [--workers N]

    fast     the everyday lane: loom lint, types and unit tier; arras check and vitest; the docs checks that judge what a change wrote
    full     before a commit: fast, plus the checks that compare the working tree with git and with the generators' output, loom's TeX tier and every arras Playwright suite
    paper    the paper tier, which needs LOOM_PAPER_FIXTURES; run by hand
    client   the client tier: a quilt's generated agent configuration tried against the real Claude Code, which calls a hosted model on your account; run by hand
    --steps  exactly the named steps (the table's names without the lane, e.g. "pytest tex"), whatever their tier
    --workers  how many test workers the run may use in all (`VERIFY_WORKERS` says the same); by default half the cores less what the machine is already carrying, never under two

CI runs this script and nothing else, each lane's workflow in `.github/workflows/` with the arguments it names (docs/contributing.md). Under GitHub Actions (`GITHUB_ACTIONS` set) a failing step's output is printed whole and the CI state is not printed.

The machine is shared, so a run keeps to a budget of workers (`budget`): loom's pytest and the Playwright suites divide it, and a suite started by hand reads the same `VERIFY_WORKERS` (`arras/tests/sites.ts`). Under GitHub Actions there is no budget and every suite takes what it takes alone.

Lanes run in parallel and the steps within a lane in order, except that consecutive steps marked `concurrent` run together once the steps before them are done: arras builds once, then its three Playwright suites and the figure script run at the same time, each on its own copy of that build and its own ports (`arras/tests/sites.ts`). Those ports are the machine's, so a run takes the first slot no other run or server holds, and keeps it until it ends. Every deselection and skip lives here with its reason, never in a plan.
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import socket
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field, replace
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
#: The unit tier: what needs no real TeX, paper, network or client, and does not compare the working tree with git or with a generator's output (`tree`), which a session with files not yet added, or a branch that leaves generated files to the integrator, fails for no fault of its change.
UNIT = "not tex and not paper and not network and not client and not tree"
LOOM_XDIST = ["-n", "auto", "--dist", "loadgroup"]
# the one arras build of a run, which every Playwright suite copies; a slot gives the suites ports and scratch directories apart from a suite started by hand and from another worktree's run (arras/tests/sites.ts); `{slot}` is filled in by `in_slot`
ARRAS_BUILD = ".tmp-e2e/slot-{slot}/bundle"
ARRAS_SUITE_ENV = {"ARRAS_SLOT": "{slot}", "ARRAS_PREBUILT": str(ROOT / "arras" / ARRAS_BUILD)}
# where the figure script writes when verify runs it
SHOTS_OUT = str(ROOT / "arras" / ".tmp-e2e" / "slot-{slot}" / "shots-out")
#: The slots a run may take; slot 0 is a suite started by hand, and CI's fresh runner takes slot 1, where its workflow looks for the build.
SLOTS = range(1, 60)
#: Bound for the length of a run to claim a slot: the base port no suite serves on, shifted by the slot as the others are.
CLAIM_PORT = 4175


@dataclass
class Step:
    lane: str
    name: str
    cwd: str
    cmd: list[str]
    tiers: tuple[str, ...]
    env: dict[str, str] = field(default_factory=dict)
    #: run at the same time as the adjacent concurrent steps, after every step before them
    concurrent: bool = False


STEPS = [
    Step("loom", "ruff", "loom", ["uv", "run", "ruff", "check", "src", "tests", "scripts"], ("fast", "full")),
    Step(
        "loom",
        "ruff format",
        "loom",
        ["uv", "run", "ruff", "format", "--check", "src", "tests", "scripts"],
        ("fast", "full"),
    ),
    Step("loom", "mypy", "loom", ["uv", "run", "mypy", "src"], ("fast", "full")),
    # every loom tier runs on xdist workers, one process each; nothing is serialised, and `loadgroup` only keeps the tests sharing a module's `once` quilt on one worker so it is built once (tests/conftest.py)
    Step("loom", "pytest unit", "loom", ["uv", "run", "pytest", *LOOM_XDIST, "-m", UNIT], ("fast", "full")),
    # the tracked-file guard and the checks that the committed quilts, tool list and command reference are what their generators write
    Step("loom", "pytest tree", "loom", ["uv", "run", "pytest", *LOOM_XDIST, "-m", "tree"], ("full",)),
    # the biber test skips itself where biber is absent; nothing is deselected by hand
    Step("loom", "pytest tex", "loom", ["uv", "run", "pytest", *LOOM_XDIST, "-m", "tex"], ("full",)),
    Step("loom", "pytest paper", "loom", ["uv", "run", "pytest", *LOOM_XDIST, "-m", "paper"], ("paper",)),
    # choosing the tier is the consent its gate stands for, so the step sets it; one turn at a time, not on xdist workers, since each spends on the account of whoever runs it
    Step("loom", "pytest client", "loom", ["uv", "run", "pytest", "-m", "client"], ("client",), env={"LOOM_CLIENT_TESTS": "1"}),
    Step("arras", "svelte-check", "arras", ["npm", "run", "check"], ("fast", "full")),
    Step("arras", "vitest", "arras", ["npx", "vitest", "--run"], ("fast", "full")),
    Step("arras", "build", "arras", ["node", "scripts/bundle.mjs", ARRAS_BUILD], ("full",)),
    *(
        Step("arras", name, "arras", cmd, ("full",), env=ARRAS_SUITE_ENV, concurrent=True)
        for name, cmd in (
            ("e2e", ["npx", "playwright", "test"]),
            ("write", ["npm", "run", "test:write"]),
            ("reading", ["npm", "run", "test:reading"]),
        )
    ),
    # the figure script, run to check it still runs, into scratch rather than over the committed figures, which a re-run does not reproduce byte for byte; a stale script otherwise surfaces only at the next re-shoot
    *(
        Step("arras", name, "arras", cmd, ("full",), env=ARRAS_SUITE_ENV | {"ARRAS_SHOTS_OUT": SHOTS_OUT}, concurrent=True)
        for name, cmd in (
            ("shots", ["npm", "run", "shots"]),
        )
    ),
    Step(
        "docs",
        "work queue",
        ".",
        ["uv", "run", "--project", "loom", "python", "docs/work-queue/check.py"],
        ("fast", "full"),
    ),
    # the agreement checks: each standard library only, runnable alone, printing what disagrees and the command that fixes it; the two that compare committed copies and the vendored bundle with their sources run with the other working-tree checks, in `full`
    *(
        Step("docs", name, ".", [sys.executable, f"scripts/checks/{script}"], tiers)
        for name, script, tiers in (
            ("principles", "principles.py", ("fast", "full")),
            ("fixtures", "fixtures.py", ("full",)),
            ("bundle", "bundle.py", ("full",)),
            ("hard wrap", "hardwrap.py", ("fast", "full")),
        )
    ),
]


@dataclass
class Result:
    step: Step
    ok: bool
    seconds: float
    output: str


def env() -> dict[str, str]:
    """The caller's environment without what would leak into the suites: an activated virtualenv, which uv then warns about, and an agent's session. The tier gates pass through."""
    gates = ("LOOM_PAPER_FIXTURES", "LOOM_NETWORK", "LOOM_CLIENT_TESTS")
    out = {k: v for k, v in os.environ.items() if k != "VIRTUAL_ENV" and (not k.startswith("LOOM_") or k in gates)}
    out["NO_COLOR"] = "1"
    out.pop("FORCE_COLOR", None)
    return out


def budget(asked: int | None) -> int | None:
    """How many test workers this run may use in all, or None for no limit.

    What was asked for (`--workers`, else `VERIFY_WORKERS`); else, under GitHub Actions, no limit, since the runner is the run's alone; else half the cores less the load the machine already carries, and never fewer than two.
    """
    if asked is None and os.environ.get("VERIFY_WORKERS", "").isdigit():
        asked = int(os.environ["VERIFY_WORKERS"])
    if asked is not None:
        return max(1, asked)
    if os.environ.get("GITHUB_ACTIONS"):
        return None
    cores = os.cpu_count() or 4
    try:
        carrying = round(os.getloadavg()[0])
    except OSError:
        carrying = 0
    return max(2, min(cores // 2, cores - carrying))


def share_workers(chosen: list[Step], workers: int | None) -> list[Step]:
    """Each step with its share of the run's workers.

    Loom's pytest and the concurrent Playwright suites each take every core by default, which on eight cores put eight pytest workers beside sixteen browsers and timed out the heaviest reading tests. Run together, pytest takes half and each suite a share of the rest by its weight; run without the other, each takes the whole. With no budget (`workers` None) the whole is the machine's cores, and a lane run alone keeps its tools' defaults. Every step is told the budget as `VERIFY_WORKERS`, which the Playwright configs read.
    """
    # the figure script keeps its one worker, so that a picture is taken with nothing else moving in its browser
    suites = [s for s in chosen if s.concurrent and not s.name.startswith("shots")]
    pytest = [s for s in chosen if s.lane == "loom" and "pytest" in s.cmd and "-n" in s.cmd]
    together = bool(suites and pytest)
    if workers is None and not together:
        return chosen
    whole = workers if workers is not None else (os.cpu_count() or 4)
    for_pytest = max(2 if workers is None else 1, whole // 2) if together else whole
    for_suites = max(1, whole - whole // 2) if together else whole
    weight = {"e2e": 2, "write": 1, "reading": 1}
    total = sum(weight.get(s.name, 1) for s in suites)
    out: list[Step] = []
    for s in chosen:
        if workers is not None:
            s = replace(s, env=s.env | {"VERIFY_WORKERS": str(workers)})
        if s in pytest:
            s = replace(s, env=s.env | {"PYTEST_XDIST_AUTO_NUM_WORKERS": str(for_pytest)})
        elif s in suites:
            extra = ["--workers", str(max(1, for_suites * weight.get(s.name, 1) // total))]
            s = replace(s, cmd=s.cmd + (["--", *extra] if s.cmd[:2] == ["npm", "run"] else extra))
        elif workers is not None and s.cmd[:2] == ["npx", "vitest"]:
            s = replace(s, cmd=[*s.cmd, f"--maxWorkers={workers}"])
        out.append(s)
    return out


def slot_ports() -> list[int]:
    """The base ports the suites serve on, from `arras/tests/sites.ts`, which owns them."""
    source = (ROOT / "arras" / "tests" / "sites.ts").read_text(encoding="utf-8")
    table = re.search(r"const PORTS = \{(.*?)\}", source)
    ports = [int(p) for p in re.findall(r":\s*(\d+)", table.group(1))] if table else []
    if not ports or CLAIM_PORT in ports:
        raise SystemExit(f"verify: arras/tests/sites.ts names no PORTS table apart from the claim port {CLAIM_PORT}")
    return ports


def free(port: int) -> bool:
    """Whether a server could listen on `port` on loopback. Asked as Node's server asks, since a closed connection's TIME_WAIT is no obstacle to one."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.bind(("127.0.0.1", port))
        except OSError:
            return False
    return True


def holders(ports: list[int]) -> str:
    """What holds `ports`, as `lsof` says; what to tell someone when no slot is free."""
    if shutil.which("lsof") is None:
        return "no lsof here to say what holds them"
    spec = [f"-iTCP:{p}" for p in ports]
    found = subprocess.run(["lsof", "-nP", "-sTCP:LISTEN", *spec], capture_output=True, text=True).stdout
    return found.rstrip() or "nothing lsof can see"


def claim_slot() -> tuple[int, socket.socket]:
    """The first slot whose ports are all free, and the socket holding it for as long as it stays open.

    Two runs starting together cannot take one slot: only one binds its claim port, exclusively, and the operating system lets it go however the run ends, so a killed run leaves nothing to clean up. A server on a suite's port (a hand-started suite, say) puts its slot out of the running too, since Playwright would refuse to start beside it.
    """
    ports = slot_ports()
    for slot in SLOTS:
        claim = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            claim.bind(("127.0.0.1", CLAIM_PORT + 100 * slot))
        except OSError:
            claim.close()
            continue
        if all(free(p + 100 * slot) for p in ports):
            return slot, claim
        claim.close()
    first = [p + 100 * SLOTS[0] for p in [CLAIM_PORT, *ports]]
    raise SystemExit(f"verify: no slot from {SLOTS[0]} to {SLOTS[-1]} is free. Slot {SLOTS[0]}'s ports:\n{holders(first)}")


def in_slot(step: Step, slot: int) -> Step:
    """`step` with its `{slot}` filled in."""
    return replace(
        step,
        cmd=[c.replace("{slot}", str(slot)) for c in step.cmd],
        env={k: v.replace("{slot}", str(slot)) for k, v in step.env.items()},
    )


def run(step: Step) -> Result:
    start = time.monotonic()
    try:
        proc = subprocess.run(
            step.cmd, cwd=ROOT / step.cwd, env=env() | step.env, capture_output=True, text=True, errors="replace"
        )
        ok, output = proc.returncode == 0, proc.stdout + proc.stderr
    except OSError as e:
        ok, output = False, f"could not run {step.cmd[0]}: {e}"
    return Result(step, ok, time.monotonic() - start, output)


def lane(steps: list[Step]) -> list[Result]:
    """Run a lane's steps in order, each run of adjacent `concurrent` steps as one group."""
    results: list[Result] = []
    i = 0
    while i < len(steps):
        j = i + 1
        if steps[i].concurrent:
            while j < len(steps) and steps[j].concurrent:
                j += 1
        with ThreadPoolExecutor(max_workers=j - i) as pool:
            results += pool.map(run, steps[i:j])
        i = j
    return results


def summary(output: str) -> str:
    """The line a reader wants from a passing suite: pytest's, vitest's or Playwright's count."""
    keys = (
        "passed",
        "failed",
        "Tests ",
        "COMPLETED",
        "work queue ok",
        ": ok (",
        "All checks passed",
        "already formatted",
        "Success:",
    )
    for line in reversed(output.splitlines()):
        if any(k in line for k in keys):
            return re.sub(r"^\d{10,} ", "", " ".join(line.split()).strip("= "))[:70]
    return ""


def ci_state() -> str:
    """The branch's latest CI runs, from `gh`; never called inside CI itself."""
    if shutil.which("gh") is None:
        return "gh is not installed; CI state unknown"
    branch = subprocess.run(
        ["git", "branch", "--show-current"], cwd=ROOT, capture_output=True, text=True
    ).stdout.strip()
    proc = subprocess.run(
        ["gh", "run", "list", "--branch", branch, "--limit", "3"], cwd=ROOT, capture_output=True, text=True
    )
    return (proc.stdout or proc.stderr).rstrip() or f"no CI runs on {branch}"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    parser.add_argument("tier", nargs="?", choices=("fast", "full", "paper", "client"), help="default fast")
    parser.add_argument("--only", choices=("loom", "arras", "docs"))
    parser.add_argument("--steps", help="comma-separated step names to run whatever their tier, instead of a tier")
    parser.add_argument("--workers", type=int, help="test workers the run may use in all; default from the cores and the load")
    args = parser.parse_args()
    if args.steps is None:
        tier = args.tier or "fast"
        chosen = [s for s in STEPS if tier in s.tiers and (args.only is None or s.lane == args.only)]
    else:
        if args.tier:
            parser.error("--steps names the steps to run; give it without a tier")
        names = [n.strip() for n in args.steps.split(",") if n.strip()]
        unknown = [n for n in names if n not in {s.name for s in STEPS}]
        if unknown or not names:
            parser.error(f"no step {', '.join(map(repr, unknown)) or 'named'}; the steps are {', '.join(s.name for s in STEPS)}")
        chosen = [s for s in STEPS if s.name in names and (args.only is None or s.lane == args.only)]
    workers = budget(args.workers)
    chosen = share_workers(chosen, workers)
    if workers is not None:
        print(f"{workers} test workers ({os.cpu_count() or 4} cores; --workers or VERIFY_WORKERS chooses)", flush=True)
    # held until the process ends; only a run that serves anything needs one
    if any("ARRAS_SLOT" in s.env for s in chosen):
        slot, claim = claim_slot()
        chosen = [in_slot(s, slot) for s in chosen]
        # no build in this run means none in this slot to copy, so each suite's `scripts/bundle.mjs` builds, under its lock
        if not any(s.name == "build" for s in chosen):
            chosen = [replace(s, env={k: v for k, v in s.env.items() if k != "ARRAS_PREBUILT"}) for s in chosen]
        print(f"arras suites in slot {slot}, on ports from {min(slot_ports()) + 100 * slot}", flush=True)
    lanes: dict[str, list[Step]] = {}
    for s in chosen:
        lanes.setdefault(s.lane, []).append(s)
    started = time.monotonic()
    with ThreadPoolExecutor(max_workers=len(lanes) or 1) as pool:
        results = [r for rs in pool.map(lane, lanes.values()) for r in rs]
    width = max((len(f"{r.step.lane} {r.step.name}") for r in results), default=10)
    print(f"\n{'suite':<{width}}  result  seconds  summary")
    for r in results:
        print(
            f"{r.step.lane + ' ' + r.step.name:<{width}}  {'ok' if r.ok else 'FAIL':<6}  {r.seconds:7.1f}  {summary(r.output)}"
        )
    print(f"{'wall':<{width}}          {time.monotonic() - started:7.1f}")
    failed = [r for r in results if not r.ok]
    # a CI log is the only record of a failure there, so it gets the whole output; a terminal gets the tail
    ci = bool(os.environ.get("GITHUB_ACTIONS"))
    for r in failed:
        print(f"\n===== {r.step.lane} {r.step.name}: {' '.join(r.step.cmd)} (in {r.step.cwd}) =====")
        print(r.output.rstrip() if ci else r.output.rstrip()[-8000:])
    if not ci:
        print("\nCI on this branch:\n" + ci_state())
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
