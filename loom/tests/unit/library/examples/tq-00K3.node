+++
Let $W$ be a widget (Definition~\ref{tq-00A4}). Then
\begin{enumerate}
\item $\diam W < \infty$; and
\item for every $x_0 \in W$, each point $x$ of $W$ satisfies
\begin{equation}\label{tq-00K3-eq00}
  |x| \le \diam W + |x_0| .
\end{equation}
\end{enumerate}
