;; A TeX compile loom starts, fenced: latexmk with pdflatex, bibtex or biber, or make4ht, in a staged copy of a document's folder.
;; Parameters, each a resolved absolute path, given with -D and never written into this text:
;; STAGE (the staged sources, and for make4ht its output, home and temporary folder), OUT (the run's output folder, its temporary folder and a clone of biber's unpacked folder),
;; TEXROOT (the TeX in use), TEXMFVAR (TeX's cache for this person), TEXMFHOME (the person's own TeX files),
;; DEVDIR (the developer tools, which TeX Live's universal biber reaches through /usr/bin/lipo), USERTMP (the per-user temporary folder, where xcrun keeps its cache).
(version 1)
(deny default)
(import "system.sb")
(allow process-exec process-fork)
(allow file-read* (subpath (param "STAGE")) (subpath (param "OUT")) (subpath (param "TEXROOT")) (subpath (param "TEXMFVAR")) (subpath (param "TEXMFHOME"))
                  (subpath (param "DEVDIR")) (subpath "/bin") (subpath "/usr/bin")
                  (literal (string-append (param "USERTMP") "/xcrun_db"))
                  ;; whether the Xcode licence is agreed, which xcrun checks before it runs lipo whenever its cache does not answer: a system file, the same for every person
                  (literal "/Library/Preferences/com.apple.dt.Xcode.plist"))
(allow file-read-metadata (path-ancestors (param "STAGE")) (path-ancestors (param "OUT")) (path-ancestors (param "TEXROOT")) (path-ancestors (param "TEXMFVAR"))
                  (path-ancestors (param "TEXMFHOME")) (path-ancestors (param "DEVDIR")) (path-ancestors (param "USERTMP")))
(allow file-write* (subpath (param "STAGE")) (subpath (param "OUT")) (subpath (string-append (param "TEXMFVAR") "/fonts")))
